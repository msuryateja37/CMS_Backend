generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum IncidentStatus {
  RAISED
  POOL                 // safety/env/other: waiting for a province OHS practitioner to pick up
  UNDER_REVIEW
  REJECTED
  ASSIGNED
  INVESTIGATION_IN_PROGRESS
  TASK_IN_PROGRESS
  WAITING_APPROVAL
  ESCALATED_TO_ADMIN   // pool item not picked up within the SLA window, or no OHS in province
  COMPLETED
  REOPENED
  CLOSED
}

// Which coverage function a province slot represents.
enum CoverageFunction {
  OHS_PRACTITIONER
  FIRST_AIDER
  HR
}



enum InvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  INSERT
  UPDATE
  DELETE
}

//////////////////////////////////////////////////////
// MASTER TABLES
//////////////////////////////////////////////////////

// MASTER TABLES
//////////////////////////////////////////////////////

model Province {
  id        String     @id @default(uuid())
  name      String     @unique
  buildings Building[]
  users     User[]
  incidents Incident[]
  coverage  ProvinceAssignment[]
  createdAt DateTime   @default(now())
}

// One OHS practitioner and one first aider slot per province.
// The unique constraint enforces "at most one per (province, function)".
// A province with no row for a function = no coverage (gap case).
model ProvinceAssignment {
  id         String           @id @default(uuid())
  province   Province         @relation(fields: [provinceId], references: [id])
  provinceId String
  function   CoverageFunction
  user       User?            @relation("ProvinceCoverage", fields: [userId], references: [id])
  userId     String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([provinceId, function])
}

model Building {
  id         String     @id @default(uuid())
  name       String
  address    String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  province   Province   @relation(fields: [provinceId], references: [id])
  provinceId String
  incidents  Incident[]
  inspections Inspection[]
  drills     Drill[]
  equipment  Equipment[]
  departments Department[]
  createdAt  DateTime   @default(now())
}

model Department {
  id         String   @id @default(uuid())
  name       String   @unique
  building   Building? @relation(fields: [buildingId], references: [id])
  buildingId String?
  users      User[]
  incidents  Incident[]
}

//////////////////////////////////////////////////////
// USER & RBAC
//////////////////////////////////////////////////////

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  phone        String?
  employeeNumber String?   @unique
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?
  province     Province?   @relation(fields: [provinceId], references: [id])
  provinceId   String?

  roles         UserRole[]
  notifications Notification[]

  createdAt DateTime  @default(now())
  isActive  Boolean   @default(true)
  lastLoginAt DateTime?
  deletedAt DateTime?

  // Back-relations for Incident and related entities
  reportedIncidents    Incident[]           @relation("ReportedBy")
  assignedIncidents    IncidentAssignment[] @relation("AssignedTo")
  assignedByIncidents  IncidentAssignment[] @relation("AssignedBy")
  incidentComments     IncidentComment[]
  incidentStatusLogs   IncidentStatusLog[]
  uploadedMedia        IncidentMedia[]      @relation("MediaUploader")
  investigations       Investigation[]
  approvalsUploaded    Approval[]
  inspectionsConducted Inspection[]         @relation("Inspector")
  formResponses        FormResponse[]
  formsCreated         Form[]               @relation("FormCreator")
  provinceCoverage     ProvinceAssignment[] @relation("ProvinceCoverage")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id     String           @id @default(uuid())
  name   String           @unique
  module String
  roles  RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

//////////////////////////////////////////////////////
// INCIDENT CORE
model Incident {
  id               String         @id @default(uuid())
  incidentNumber   String         @unique
  type             String?        // Added for compatibility
  description      String
  category         String
  severity         String
  immediateActions String?
  otherActions     String?        // Additional actions taken
  impact           String?
  location         String?        // Location description
  peopleImpacted   Int?           // Number of people impacted
  status           IncidentStatus @default(RAISED)

  building   Building @relation(fields: [buildingId], references: [id])
  buildingId String

  // Denormalised province for pool routing / coverage lookups (derived from building on create).
  province   Province? @relation(fields: [provinceId], references: [id])
  provinceId String?

  // For pool cases (safety/env/other): when the pickup SLA lapses (raise + 3 days).
  pickupDueAt DateTime?

  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  reportedBy   User   @relation("ReportedBy", fields: [reportedById], references: [id])
  reportedById String

  latitude   Float?
  longitude  Float?
  occurredAt DateTime

  correctiveActions CorrectiveAction[]
  approvals         Approval[]
  incidentPlan      String?
  investigations  Investigation[]
  invoices        Invoice[]
  slaTracking     IncidentSLATracking?
  comments        IncidentComment[]
  statusLogs      IncidentStatusLog[]
  assignments     IncidentAssignment[]
  media           IncidentMedia[]
  impactedPeople  ImpactedPerson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isEscalated      Boolean   @default(false)
  escalatedAt      DateTime?
  escalationReason String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?
}

model ImpactedPerson {
  id         String   @id @default(uuid())
  name       String
  email      String
  phone      String?
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String
  createdAt  DateTime @default(now())
}

// ALIAS for backward compatibility or direct usage by CasesService if refactoring is hard
// But better to migrate code. For now, adding missing specialized models.

model IncidentMedia {
  id           String   @id @default(uuid())
  fileUrl      String
  fileType     String
  fileName     String?
  uploaderRole String?
  uploadedBy   User?    @relation("MediaUploader", fields: [uploadedById], references: [id])
  uploadedById String?
  incident     Incident @relation(fields: [incidentId], references: [id])
  incidentId   String
  uploadedAt   DateTime @default(now())
}

// ... existing models ...

// OHS & RISK MANAGEMENT

model RiskRegister {
  id           String   @id @default(uuid())
  title        String
  description  String?
  riskLevel    String
  mitigation   String?
  departmentId String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Jsa {
  id          String   @id @default(uuid())
  jobName     String
  hazards     Json?
  controls    Json?
  remarks     String?
  status      String?  @default("Draft")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("jsa") // Map to lowercase table name as per raw query usage
}

model Inspection {
  id          String              @id @default(uuid())
  type        String
  status      String              @default("SCHEDULED")
  building    Building?           @relation(fields: [buildingId], references: [id])
  buildingId  String?
  inspector   User?               @relation("Inspector", fields: [inspectorId], references: [id])
  inspectorId String?
  conductedAt DateTime?
  findings    InspectionFinding[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model InspectionFinding {
  id             String     @id @default(uuid())
  inspection     Inspection @relation(fields: [inspectionId], references: [id])
  inspectionId   String
  finding        String
  actionRequired String?
  status         String     @default("OPEN")
  dueDate        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// EMERGENCY

model EmergencyPlan {
  id          String   @id @default(uuid())
  title       String
  version     String
  fileUrl     String?
  documentPath String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Drill {
  id            String    @id @default(uuid())
  name          String
  type          String
  scheduledDate DateTime
  status        String    @default("SCHEDULED")
  building      Building? @relation(fields: [buildingId], references: [id])
  buildingId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Equipment {
  id             String    @id @default(uuid())
  name           String
  type           String
  serialNumber   String?
  status         String    @default("OPERATIONAL")
  building       Building? @relation(fields: [buildingId], references: [id])
  buildingId     String?
  lastServiceDate DateTime?
  nextServiceDate DateTime?
  lastChecked     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// KPI & PDCA

model Kpi {
  id          String      @id @default(uuid())
  name        String
  targetValue Float
  unit        String
  frequency   String
  records     KpiRecord[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model KpiRecord {
  id        String   @id @default(uuid())
  kpi       Kpi      @relation(fields: [kpiId], references: [id])
  kpiId     String
  value     Float
  period    String
  recordedAt DateTime @default(now())
}

model PdcaAction {
  id          String   @id @default(uuid())
  title       String
  phase       String   // Plan, Do, Check, Act
  description String?
  status      String   @default("Pending")
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// INVOICE ACTIONS (Missing in previous schema review)

model InvoiceAction {
    id        String   @id @default(uuid())
    invoice   Invoice  @relation(fields: [invoiceId], references: [id])
    invoiceId String
    action    String
    actorId   String
    timestamp DateTime @default(now())
}

// ... existing SLA ...


//////////////////////////////////////////////////////
// REVIEW & ASSIGNMENT
//////////////////////////////////////////////////////

model IncidentAssignment {
  id           String   @id @default(uuid())
  incident     Incident @relation(fields: [incidentId], references: [id])
  incidentId   String
  assignedTo   User     @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedToId String
  assignedBy   User     @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedById String
  assignedAt   DateTime @default(now())
}

model IncidentComment {
  id          String   @id @default(uuid())
  incident    Incident @relation(fields: [incidentId], references: [id])
  incidentId  String
  comment     String
  commentedBy User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())
}

model IncidentStatusLog {
  id         String         @id @default(uuid())
  incident   Incident       @relation(fields: [incidentId], references: [id])
  incidentId String
  oldStatus  IncidentStatus?
  newStatus  IncidentStatus
  comments   String?
  changedBy  User           @relation(fields: [userId], references: [id])
  userId     String
  changedAt  DateTime       @default(now())
}

//////////////////////////////////////////////////////
// INVESTIGATION
//////////////////////////////////////////////////////

model Investigation {
  id             String    @id @default(uuid())
  incident       Incident  @relation(fields: [incidentId], references: [id])
  incidentId     String
  practitioner   User      @relation(fields: [practitionerId], references: [id])
  practitionerId String
  siteLat        Float?
  siteLng        Float?
  notes          String?
  startedAt      DateTime?
  completedAt    DateTime?
}

//////////////////////////////////////////////////////
// CORRECTIVE ACTIONS & APPROVALS
//////////////////////////////////////////////////////

model CorrectiveAction {
  id           String      @id @default(uuid())
  actionText   String      @db.Text
  status       String      @default("pending") // pending | in_progress | completed
  dueDate      DateTime?
  completedAt  DateTime?
  notes        String?     @db.Text
  incident     Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId   String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Approval {
  id                   String                 @id @default(uuid())
  roleName             String
  recommenderName      String?
  recommendationText   String?                @db.Text
  incident             Incident               @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId           String
  uploadedBy           User?                  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  attachments          ApprovalAttachment[]
}

model ApprovalAttachment {
  id         String   @id @default(uuid())
  fileUrl    String
  fileName   String?
  fileType   String?
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approvalId String
  createdAt  DateTime @default(now())

  @@index([approvalId])
}

//////////////////////////////////////////////////////
// INVOICES
//////////////////////////////////////////////////////

model Invoice {
  id          String        @id @default(uuid())
  invoiceNumber String?
  amount      Float
  description String?
  status      InvoiceStatus @default(PENDING)
  receivedDate DateTime?    @default(now())

  createdAt   DateTime      @default(now())
  incident    Incident?     @relation(fields: [incidentId], references: [id])
  incidentId  String?
  actions     InvoiceAction[]
}

//////////////////////////////////////////////////////
// SLA & ESCALATION
//////////////////////////////////////////////////////

model SLA {
  id                   String                @id @default(uuid())
  category             String
  severity             String
  resolutionMinutes    Int
  responseMinutes      Int
  createdAt            DateTime              @default(now())
  incidentSLATrackings IncidentSLATracking[]
}

model IncidentSLATracking {
  id                 String    @id @default(uuid())
  incident           Incident  @relation(fields: [incidentId], references: [id])
  incidentId         String    @unique
  sla                SLA       @relation(fields: [slaId], references: [id])
  slaId              String
  responseDueAt      DateTime
  resolutionDueAt    DateTime
  responseBreached   Boolean   @default(false)
  resolutionBreached Boolean   @default(false)
  breachedAt         DateTime?
}

model EscalationRule {
  id               String @id @default(uuid())
  category         String
  severity         String
  breachType       String
  escalateToRoleId String
  escalateAfterMin Int
}

//////////////////////////////////////////////////////
// NOTIFICATIONS
//////////////////////////////////////////////////////

model Notification {
  id          String   @id @default(uuid())
  title       String
  message     String
  module      String
  referenceId String?
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model SyncQueue {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  payload   Json
  status    String   @default("PENDING")
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
//////////////////////////////////////////////////////
// AUDIT LOG
//////////////////////////////////////////////////////

model AuditLog {
  id        String      @id @default(uuid())
  tableName String
  recordId  String
  action    AuditAction
  oldData   Json?
  newData   Json?
  changedBy String?
  changedAt DateTime    @default(now())
}

//////////////////////////////////////////////////////
// DYNAMIC FORMS  (two-layer versioning)
// ─ Canvas layer: FormSection → QuestionInput → QuestionOption
// ─ Snapshot layer: FormVersion.schema (frozen JSONB on publish)
//////////////////////////////////////////////////////

// ── Enums ────────────────────────────────────────

enum FormVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InputType {
  TEXT
  NUMBER
  DATE
  TEXTAREA
  RADIO
  CHECKBOX
  SELECT
}

// ── Form ─────────────────────────────────────────
// Stable identity anchor; never mutated after creation.

model Form {
  id        String   @id @default(uuid())
  slug      String?  @unique
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator   User?          @relation("FormCreator", fields: [createdBy], references: [id])
  versions  FormVersion[]
  responses FormResponse[]
}

// ── FormVersion ───────────────────────────────────
// One row per draft or published version.
// `schema` is null while DRAFT; serialised from canvas on publish, then frozen.

model FormVersion {
  id            String            @id @default(uuid())
  formId        String
  versionNumber Int               // monotonically increasing per form
  title         String
  description   String?
  status        FormVersionStatus @default(DRAFT)
  isActive      Boolean           @default(false)  // exactly ONE per form is true
  schema        Json?             // null while DRAFT; frozen on publish
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())

  form          Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  sections      FormSection[]
  responses     FormResponse[]

  @@unique([formId, versionNumber])
  @@index([formId, isActive])
  @@index([formId, status])
}

// ── FormSection ───────────────────────────────────
// Canvas only. Never deleted after publish (FK integrity for QuestionInput).

model FormSection {
  id            String        @id @default(uuid())
  formVersionId String
  title         String
  description   String?
  orderIndex    Int

  formVersion   FormVersion   @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  questions     QuestionInput[]

  @@index([formVersionId, orderIndex])
}

// ── QuestionInput ─────────────────────────────────
// Canvas only. UUID bridges canvas ↔ snapshot ↔ analytics.

model QuestionInput {
  id              String            @id @default(uuid())
  sectionId       String
  label           String
  inputType       InputType
  placeholder     String?
  isRequired      Boolean           @default(false)
  orderIndex      Int
  validationRules Json?

  section         FormSection       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options         QuestionOption[]
  responses       QuestionResponse[]

  @@index([sectionId, orderIndex])
}

// ── QuestionOption ────────────────────────────────
// Canvas only. UUID embedded in schema JSON.

model QuestionOption {
  id          String            @id @default(uuid())
  questionId  String
  optionLabel String
  optionValue String
  orderIndex  Int

  question    QuestionInput     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses   QuestionResponse[]

  @@index([questionId, orderIndex])
}

// ── FormResponse ──────────────────────────────────
// Pinned to the active FormVersion at submit time.

model FormResponse {
  id            String      @id @default(uuid())
  formId        String
  formVersionId String
  submittedBy   String?
  submittedAt   DateTime    @default(now())

  form          Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersion   FormVersion @relation(fields: [formVersionId], references: [id])
  submitter     User?       @relation(fields: [submittedBy], references: [id])
  answers       QuestionResponse[]

  @@index([formId, submittedAt])
  @@index([formVersionId])
  @@index([submittedBy, submittedAt])
}

// ── QuestionResponse ──────────────────────────────
// One row per answered question per submission.

model QuestionResponse {
  id               String          @id @default(uuid())
  responseId       String
  questionId       String
  answerText       String?
  selectedOptionId String?
  comment          String?

  response         FormResponse    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question         QuestionInput   @relation(fields: [questionId], references: [id])
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([questionId])
  @@index([questionId, selectedOptionId])
}

